import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();
        int key = sc.nextInt();
        int rev = 0, p = 1;
        while (num > 0) {
            if (num%10 != key)
            {
                rev = rev + (num%10)*p;
                p*=10;
            }
            num /= 10;
        }
        System.out.println(rev);
    }
}
